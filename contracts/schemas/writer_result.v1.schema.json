{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "writer_result.v1",
  "title": "S4 writer draft and diagnostics",
  "$comment": "v1 (T017-FIX): writer_result.v0 plus the required, nullable effective_system_hash, the sha256 of the canonical JSON array of the system texts the last writer request sent (model_mapping.effective_system_hash; one entry when the addendum is joined, two when it is a separate message); null when no request was sent. v0 stays as a superseded file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "output",
    "calls",
    "warnings",
    "error",
    "brief_hash",
    "system_prompt_hash",
    "addendum_hash",
    "effective_system_hash"
  ],
  "properties": {
    "state": {
      "enum": [
        "draft",
        "failed"
      ]
    },
    "output": {
      "type": [
        "string",
        "object",
        "array",
        "null"
      ]
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "record_json"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "record_json": {
            "type": "string"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    },
    "brief_hash": {
      "type": "string"
    },
    "system_prompt_hash": {
      "type": "string"
    },
    "addendum_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_system_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
