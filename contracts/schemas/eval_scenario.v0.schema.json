{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eval_scenario.v0",
  "title": "Evaluation scenario",
  "$comment": "Draft v0. Follows docs/stages/G-evaluation.md (R-023). Silver means generated by an agent with an answer key from folder declarations; gold means a real user prompt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "kind",
    "task",
    "prompt",
    "source_image",
    "expected_concept_links",
    "expected_constraints",
    "generator",
    "tier",
    "split"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "enum": [
        "generate",
        "edit"
      ]
    },
    "prompt": {
      "type": "string"
    },
    "source_image": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image_id",
            "folder_id"
          ],
          "properties": {
            "image_id": {
              "type": "string",
              "minLength": 1
            },
            "folder_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_concept_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mention",
          "status",
          "concept_id",
          "role"
        ],
        "properties": {
          "mention": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "resolved",
              "family",
              "no_match"
            ]
          },
          "concept_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "anyOf": [
              {
                "enum": [
                  "subject_identity",
                  "worn_garment",
                  "location",
                  "object",
                  "style_reference",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "expected_constraints": {
      "$ref": "constraint_ledger.v0"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "model_revision",
        "prompt_id"
      ],
      "properties": {
        "role": {
          "const": "scenario_generator"
        },
        "model_revision": {
          "type": "string",
          "minLength": 1
        },
        "prompt_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tier": {
      "enum": [
        "silver",
        "gold"
      ]
    },
    "split": {
      "enum": [
        "fit",
        "test"
      ]
    }
  }
}
