    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "text",
          "span",
          "bound_entity"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
