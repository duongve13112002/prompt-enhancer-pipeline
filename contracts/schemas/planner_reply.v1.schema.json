            "properties": {
              "facet": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string"
              },
              "source": {
                "enum": [
                  "user",
                  "source_image"
                ]
              },
              "source_indexes": {
                "anyOf": [
                  {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "links": {
      "type": "array",
