                },
                "ratings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "variant_position",
                      "context_fit"
                    ],
                    "properties": {
                      "variant_position": {
                        "type": "integer",
                        "minimum": 0
