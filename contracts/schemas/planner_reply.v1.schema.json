  "additionalProperties": false,
  "required": [
    "edit_kind",
    "base_source_index",
    "entities",
    "scene",
    "links",
    "knowledge_needs",
    "constraints",
    "literal_texts",
    "passthrough_tokens",
    "edit_targets",
    "delta",
    "preserve",
    "dependent_effects",
    "unresolved",
    "needs_clarification",
    "clarification_candidates"
  ],
