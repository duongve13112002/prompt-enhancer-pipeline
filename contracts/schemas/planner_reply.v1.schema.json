      "enum": [
        "local_edit",
        "global_transform",
        "subject_recompose"
      ]
    },
    "base_source_index": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "count",
          "mention",
          "attributes",
          "action",
          "relations",
          "source",
          "source_indexes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "mention": {
            "type": "string",
            "minLength": 1
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "facet",
                "value",
                "source",
                "source_indexes"
              ],
              "properties": {
                "facet": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string"
                },
                "source": {
                  "enum": [
                    "user",
                    "source_image"
                  ]
                },
                "source_indexes": {
                  "anyOf": [
                    {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "predicate",
                "object_entity_id"
              ],
              "properties": {
                "predicate": {
                  "type": "string",
                  "minLength": 1
                },
                "object_entity_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "source": {
            "enum": [
              "user",
              "source_image"
            ]
          },
          "source_indexes": {
            "anyOf": [
              {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
