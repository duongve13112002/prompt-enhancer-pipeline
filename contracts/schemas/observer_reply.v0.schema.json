{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observer_reply.v0",
  "title": "Model-facing single-image observation",
  "$comment": "Pipeline identities and provenance are constructed by K2, never supplied by the model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["view", "quality", "observations"],
  "properties": {
    "view": {"type": "string", "minLength": 1},
    "quality": {"type": "number"},
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["concept_position", "facet_group", "facet", "value", "visibility", "region"],
        "properties": {
          "concept_position": {"type": "integer", "minimum": 0},
          "facet_group": {"enum": ["identity", "apparel", "object", "place", "style", "incidental", "text_in_image"]},
          "facet": {"type": "string", "minLength": 1},
          "value": {"type": "string"},
          "visibility": {"enum": ["clear", "partial", "occluded", "not_shown"]},
          "region": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["x", "y", "width", "height"],
                "properties": {
                  "x": {"type": "number", "minimum": 0, "maximum": 1},
                  "y": {"type": "number", "minimum": 0, "maximum": 1},
                  "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                  "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
                }
              },
              {"type": "null"}
            ]
          }
        }
      }
    }
  }
}
