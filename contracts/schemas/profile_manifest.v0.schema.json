{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile_manifest.v0",
  "title": "Profile manifest",
  "$comment": "Draft v0. Follows docs/stages/P-profiles.md (decisions 4 to 6). A model drafts it and the admin confirms it; the system prompt text itself is never changed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "status",
    "system_prompt_hash",
    "template_format",
    "supported_tasks",
    "output_kind",
    "output_schema_id",
    "output_language",
    "edit_output_semantics",
    "template_variables",
    "quote_semantics",
    "renderer",
    "validator",
    "conflicts",
    "golden_tests"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "confirmed",
        "active"
      ]
    },
    "system_prompt_hash": {
      "type": "string",
      "minLength": 1
    },
    "template_format": {
      "enum": [
        "sectioned",
        "plain"
      ]
    },
    "meta": {
      "type": "object",
      "$comment": "Loader metadata of the [META] section (sectioned format only); mapped to a runtime parameter only when the backend supports it.",
      "additionalProperties": {
        "type": [
          "string",
          "boolean",
          "number"
        ]
      }
    },
    "supported_tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "generate",
          "edit"
        ]
      }
    },
    "output_kind": {
      "type": "string",
      "minLength": 1
    },
    "output_schema_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "output_language": {
      "type": "string",
      "minLength": 1
    },
    "edit_output_semantics": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "template_variables": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "template_values": {
      "description": "Admin-confirmed fixed values for template variables other than the input variable (decision 81)",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "quote_semantics": {
      "type": "string",
      "minLength": 1
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepts_reference_images",
        "image_reference_syntax"
      ],
      "properties": {
        "accepts_reference_images": {
          "type": "boolean"
        },
        "image_reference_syntax": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks"
      ],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "Named structural checks the profile declares for its output; an empty list means only the generic checks run."
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "profile_rule",
          "conflicts_with",
          "decision",
          "decided_by_admin"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "profile_rule": {
            "type": "string"
          },
          "conflicts_with": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "undecided",
              "profile_wins",
              "config_wins",
              "block_activation"
            ]
          },
          "decided_by_admin": {
            "type": "boolean"
          }
        }
      }
    },
    "golden_tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
