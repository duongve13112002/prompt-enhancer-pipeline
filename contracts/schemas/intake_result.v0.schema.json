{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intake_result.v0",
  "title": "S0 intake result payload (live profile and lease stay outside JSON)",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "request_id", "prompt", "task", "profile_id", "effective_config", "config_hash", "source_image", "retrieval", "warnings", "error", "envelope"],
  "properties": {
    "outcome": {"enum": ["ready", "degraded", "refused"]},
    "request_id": {"type": "string", "minLength": 1},
    "prompt": {"type": ["string", "null"]},
    "task": {"enum": ["generate", "edit", null]},
    "profile_id": {"type": ["string", "null"], "minLength": 1},
    "effective_config": {"type": ["object", "null"]},
    "config_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_image": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false,
          "required": ["image_id", "role", "data"],
          "properties": {
            "image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "role": {"const": "source_image"},
            "data": {"type": "string", "contentEncoding": "base64"}
          }
        }
      ]
    },
    "retrieval": {
      "type": "object", "additionalProperties": false, "required": ["state", "snapshot_id"],
      "properties": {
        "state": {"enum": ["disabled", "pinned", "failed"]},
        "snapshot_id": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "pinned"}}},
         "then": {"properties": {"snapshot_id": {"type": "string"}}},
         "else": {"properties": {"snapshot_id": {"type": "null"}}}}
      ]
    },
    "warnings": {"type": "array", "uniqueItems": true, "items": {"const": "SNAPSHOT_MISSING"}},
    "error": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["code", "message"],
         "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}}
      ]
    },
    "envelope": {"oneOf": [{"type": "null"}, {"$ref": "response_envelope.v0"}]}
  },
  "allOf": [
    {"if": {"properties": {"outcome": {"const": "refused"}}},
     "then": {"properties": {"error": {"type": "object"}, "envelope": {"type": "object", "properties": {"status": {"const": "failed"}, "output": {"type": "null"}}}}},
     "else": {"properties": {
       "prompt": {"type": "string"}, "task": {"type": "string"}, "profile_id": {"type": "string"},
       "effective_config": {"type": "object"}, "config_hash": {"type": "string"}, "error": {"type": "null"}, "envelope": {"type": "null"}
     }}},
    {"if": {"properties": {"outcome": {"const": "degraded"}}},
     "then": {"properties": {"warnings": {"contains": {"const": "SNAPSHOT_MISSING"}}, "retrieval": {"properties": {"state": {"const": "failed"}}}}}},
    {"if": {"properties": {"outcome": {"const": "ready"}}},
     "then": {"properties": {"warnings": {"maxItems": 0}, "retrieval": {"properties": {"state": {"enum": ["disabled", "pinned"]}}}}}},
    {"if": {"properties": {"task": {"const": "edit"}, "outcome": {"enum": ["ready", "degraded"]}}},
     "then": {"properties": {"source_image": {"type": "object"}}}}
  ]
}
