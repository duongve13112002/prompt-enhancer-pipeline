{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planner_reply_generate.v0",
  "title": "Planner reply for generate",
  "$comment": "Draft v0 (T017-FIX). planner_reply.v0 for a generate request: edit_kind is null and edit_targets, delta, preserve and dependent_effects hold no item, as prompts/planner_v1.txt states, so a constrained decoder cannot emit edit fields and client validation refuses them (planner.py still checks the invariant). Every other member is planner_reply.v0's, unchanged; tests/test_planner_generate_schema.py derives this file from planner_reply.v0 and compares.",
  "type": "object",
  "additionalProperties": false,
  "required": ["edit_kind", "entities", "scene", "links", "knowledge_needs", "constraints", "literal_texts",
               "passthrough_tokens", "edit_targets", "delta", "preserve", "dependent_effects", "unresolved",
               "needs_clarification", "clarification_candidates"],
  "properties": {
    "edit_kind": {"type": "null"},
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "count", "mention", "attributes", "action", "relations", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "count": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
          "mention": {"type": "string", "minLength": 1},
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["facet", "value", "source"],
              "properties": {
                "facet": {"type": "string", "minLength": 1},
                "value": {"type": "string"},
                "source": {"enum": ["user", "source_image"]}
              }
            }
          },
          "action": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["predicate", "object_entity_id"],
              "properties": {
                "predicate": {"type": "string", "minLength": 1},
                "object_entity_id": {"type": "string", "minLength": 1}
              }
            }
          },
          "source": {"enum": ["user", "source_image"]}
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "medium", "attributes"],
      "properties": {
        "location": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "medium": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "attributes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["facet", "value", "source"],
            "properties": {
              "facet": {"type": "string", "minLength": 1},
              "value": {"type": "string"},
              "source": {"enum": ["user", "source_image"]}
            }
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mention", "entity_id", "status", "role", "candidate_position", "candidates", "needs_lookup",
                     "variants"],
        "properties": {
          "mention": {"type": "string", "minLength": 1},
          "entity_id": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
          "status": {"enum": ["resolved", "family", "no_match"]},
          "role": {"anyOf": [{"enum": ["subject_identity", "worn_garment", "location", "object", "style_reference",
                                       "other"]}, {"type": "null"}]},
          "candidate_position": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["position", "context_fit"],
              "properties": {
                "position": {"type": "integer", "minimum": 0},
                "context_fit": {"enum": ["fits", "neutral", "conflicts"]}
              }
            }
          },
          "needs_lookup": {"type": "boolean"},
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["candidate_position", "group_position", "named_variant_position", "ratings"],
              "properties": {
                "candidate_position": {"type": "integer", "minimum": 0},
                "group_position": {"type": "integer", "minimum": 0},
                "named_variant_position": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
                "ratings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["variant_position", "context_fit"],
                    "properties": {
                      "variant_position": {"type": "integer", "minimum": 0},
                      "context_fit": {"enum": ["fits", "neutral", "conflicts"]}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "knowledge_needs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_position", "facets"],
        "properties": {
          "candidate_position": {"type": "integer", "minimum": 0},
          "facets": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "text", "span", "bound_entity"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["literal_text", "passthrough_token", "format", "negation", "count", "relation",
                            "attribute_binding", "style", "identity_grounding", "edit_coverage", "edit_scope",
                            "edit_strength"]},
          "text": {"type": "string", "minLength": 1},
          "span": {"type": "string"},
          "bound_entity": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
        }
      }
    },
    "literal_texts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "span"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string"},
          "span": {"type": "string"}
        }
      }
    },
    "passthrough_tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token", "span"],
        "properties": {
          "token": {"type": "string", "minLength": 1},
          "span": {"type": "string"}
        }
      }
    },
    "edit_targets": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "entity_id", "locator"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "entity_id": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
          "locator": {"type": "string", "minLength": 1}
        }
      }
    },
    "delta": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target_id", "operation", "description"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "target_id": {"type": "string", "minLength": 1},
          "operation": {"type": "string", "minLength": 1},
          "description": {"type": "string"}
        }
      }
    },
    "preserve": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locator", "source"],
        "properties": {
          "locator": {"type": "string", "minLength": 1},
          "source": {"enum": ["user", "edit_kind_default"]}
        }
      }
    },
    "dependent_effects": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "effect"],
        "properties": {
          "target_id": {"type": "string", "minLength": 1},
          "effect": {"type": "string"}
        }
      }
    },
    "unresolved": {"type": "array", "items": {"type": "string"}},
    "needs_clarification": {"type": "boolean"},
    "clarification_candidates": {"type": "array", "items": {"type": "string"}}
  }
}
