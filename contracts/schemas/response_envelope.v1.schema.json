{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "response_envelope.v1",
  "title": "Response envelope",
  "$comment": "Draft v1 (T017-FIX3; response_envelope.v0 plus retrieval.error and the state not_reached, decisions 198 and 200). Follows docs/stages/S6-envelope.md. Attachments live outside output (R-011, R-012). retrieval.error is a closed code, never text (R-026): null unless state is failed, and then the code of the stage that failed (S1, the planner's grounding read, S3 or the intake knowledge boundary). not_reached: retrieval was on but S3 never ran because an earlier stage stopped the request, with no retrieval failure seen.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "output",
    "attachments",
    "source_binding",
    "retrieval",
    "warnings",
    "trace_id"
  ],
  "properties": {
    "status": {
      "enum": [
        "success",
        "repaired",
        "degraded",
        "needs_clarification",
        "failed"
      ]
    },
    "output": {
      "type": [
        "string",
        "object",
        "array",
        "null"
      ],
      "description": "Exactly the form the profile's output contract defines; no citations, warnings or debug fields (R-024)."
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "image_id",
          "role",
          "bind_to",
          "use_for"
        ],
        "properties": {
          "image_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "source_image",
              "user_reference",
              "knowledge_reference"
            ]
          },
          "bind_to": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "use_for": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "source_binding": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_image_id"
          ],
          "properties": {
            "source_image_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "snapshot_id",
        "error"
      ],
      "properties": {
        "state": {
          "enum": [
            "disabled",
            "skipped_no_knowledge_needed",
            "retrieved",
            "no_match",
            "failed",
            "not_reached"
          ]
        },
        "snapshot_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "enum": [
            null,
            "WINDOW_BUDGET_EXCEEDED",
            "SNAPSHOT_MISSING",
            "RETRIEVAL_FAILED",
            "KNOWLEDGE_READ_FAILED",
            "KNOWLEDGE_FAILED"
          ]
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "enum": [
          "PARAM_UNSUPPORTED",
          "SCHEMA_INVALID",
          "TRUNCATED",
          "SNAPSHOT_MISSING",
          "PROFILE_CONFLICT",
          "BUDGET_EXHAUSTED",
          "VERIFIER_UNCALIBRATED"
        ]
      }
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
