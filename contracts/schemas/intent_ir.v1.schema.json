{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intent_ir.v1",
  "title": "Intent IR",
  "$comment": "Draft v1 (MS-1, designed, not yet implemented). The Intent IR of an edit with two or more source images; one source image keeps intent_ir.v0. Same as intent_ir.v0 plus base_source_index and source_indexes as in planner_reply.v1, and the schema also ties them: base_source_index is an integer unless edit_kind is subject_recompose; an entity or attribute has a source_indexes list exactly when its source is source_image. Source indexes are 1-based positions in the request order of the source images and exist only when the request holds two or more (decision 179). The schema checks what a schema can: integers of at least 1, a non-empty list, no repeats. Code, which knows n, checks each index is at most n and the list is ascending (MS-4). The n images give one output image; base_source_index is the image being edited, whose unchanged parts stay.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "edit_kind",
    "base_source_index",
    "entities",
    "scene",
    "concept_links",
    "rejected_candidates",
    "knowledge_needs",
    "constraint_ledger",
    "literal_texts",
    "passthrough_tokens",
    "edit_targets",
    "delta",
    "preserve",
    "dependent_effects",
    "unresolved",
    "needs_clarification",
    "clarification_candidates"
  ],
  "properties": {
    "task": {
      "const": "edit"
    },
    "edit_kind": {
      "enum": [
        "local_edit",
        "global_transform",
        "subject_recompose"
      ]
    },
    "base_source_index": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "count",
          "mention",
          "attributes",
          "action",
          "relations",
          "source",
          "source_indexes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "mention": {
            "type": "string",
            "minLength": 1
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "facet",
                "value",
                "source",
                "source_indexes"
              ],
              "properties": {
                "facet": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string"
                },
                "source": {
                  "enum": [
                    "user",
                    "source_image"
                  ]
                },
                "source_indexes": {
                  "anyOf": [
                    {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "source": {
                        "const": "source_image"
                      }
                    },
                    "required": [
                      "source"
                    ]
                  },
                  "then": {
                    "properties": {
                      "source_indexes": {
                        "type": "array"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "source_indexes": {
                        "type": "null"
                      }
                    }
                  }
                }
              ]
            }
          },
          "action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "predicate",
                "object_entity_id"
              ],
              "properties": {
                "predicate": {
                  "type": "string",
                  "minLength": 1
                },
                "object_entity_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "source": {
            "enum": [
              "user",
              "source_image"
            ]
          },
          "source_indexes": {
            "anyOf": [
              {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source": {
                  "const": "source_image"
                }
              },
              "required": [
                "source"
              ]
            },
            "then": {
              "properties": {
                "source_indexes": {
                  "type": "array"
                }
              }
            },
            "else": {
              "properties": {
                "source_indexes": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location",
        "medium",
        "attributes"
      ],
      "properties": {
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "medium": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "facet",
              "value",
              "source",
              "source_indexes"
            ],
            "properties": {
              "facet": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string"
              },
              "source": {
                "enum": [
                  "user",
                  "source_image"
                ]
              },
              "source_indexes": {
                "anyOf": [
                  {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "source": {
                      "const": "source_image"
                    }
                  },
                  "required": [
                    "source"
                  ]
                },
                "then": {
                  "properties": {
                    "source_indexes": {
                      "type": "array"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "source_indexes": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "concept_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mention",
          "entity_id",
          "status",
          "role",
          "concept_id",
          "candidates",
          "needs_lookup"
        ],
        "properties": {
          "mention": {
            "type": "string",
            "minLength": 1
          },
          "entity_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "resolved",
              "family",
              "no_match"
            ]
          },
          "role": {
            "anyOf": [
              {
                "enum": [
                  "subject_identity",
                  "worn_garment",
                  "location",
                  "object",
                  "style_reference",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "concept_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "concept_id",
                "context_fit"
              ],
              "properties": {
                "concept_id": {
                  "type": "string",
                  "minLength": 1
                },
                "context_fit": {
                  "enum": [
                    "fits",
                    "neutral",
                    "conflicts"
                  ]
                }
              }
            }
          },
          "needs_lookup": {
            "type": "boolean"
          }
        }
      }
    },
    "rejected_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concept_id",
          "reason"
        ],
        "properties": {
          "concept_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "enum": [
              "OUT_OF_SCOPE",
              "USER_LOCKED",
              "NEGATED_BY_USER",
              "UNSTABLE",
              "VARIANT_NOT_CHOSEN",
              "BUDGET"
            ]
          }
        }
      }
    },
    "knowledge_needs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concept_id",
          "facets"
        ],
        "properties": {
          "concept_id": {
            "type": "string",
            "minLength": 1
          },
          "facets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "constraint_ledger": {
      "$ref": "constraint_ledger.v0"
    },
    "literal_texts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "span"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "span": {
            "type": "string"
          }
        }
      }
    },
    "passthrough_tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token",
          "span"
        ],
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1
          },
          "span": {
            "type": "string"
          }
        }
      }
    },
    "edit_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "entity_id",
          "locator",
          "source_indexes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "entity_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "source_indexes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "delta": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target_id",
          "operation",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "preserve": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locator",
          "source",
          "source_indexes"
        ],
        "properties": {
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": [
              "user",
              "edit_kind_default"
            ]
          },
          "source_indexes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "dependent_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "effect"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "type": "string"
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "needs_clarification": {
      "type": "boolean"
    },
    "clarification_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "edit_kind": {
            "const": "subject_recompose"
          }
        },
        "required": [
          "edit_kind"
        ]
      },
      "else": {
        "properties": {
          "base_source_index": {
            "type": "integer"
          }
        }
      }
    }
  ]
}
