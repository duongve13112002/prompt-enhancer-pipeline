{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile_validator.v0",
  "title": "Admin-confirmed structural validator",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "operator",
    "parameters"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "operator": {
      "enum": [
        "json",
        "single_line",
        "minified_json",
        "keys",
        "string_length",
        "number_range",
        "exact_text",
        "schema"
      ]
    },
    "parameters": {
      "type": "object"
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template",
        "input_variable"
      ],
      "properties": {
        "template": {
          "type": [
            "string",
            "object",
            "array"
          ]
        },
        "input_variable": {
          "const": "original_prompt"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operator": {
            "const": "json"
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operator": {
            "const": "single_line"
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operator": {
            "const": "minified_json"
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operator": {
            "const": "keys"
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pointer",
              "keys",
              "ordered"
            ],
            "properties": {
              "pointer": {
                "type": "string"
              },
              "keys": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "ordered": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operator": {
            "const": "string_length"
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pointer",
              "minimum",
              "maximum"
            ],
            "properties": {
              "pointer": {
                "type": "string"
              },
              "minimum": {
                "type": "integer",
                "minimum": 0
              },
              "maximum": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operator": {
            "const": "number_range"
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pointer",
              "minimum",
              "maximum"
            ],
            "properties": {
              "pointer": {
                "type": "string"
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operator": {
            "const": "exact_text"
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pointer",
              "value"
            ],
            "properties": {
              "pointer": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operator": {
            "const": "schema"
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema_id"
            ],
            "properties": {
              "schema_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
