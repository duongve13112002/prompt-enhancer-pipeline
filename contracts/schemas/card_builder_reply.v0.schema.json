{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "card_builder_reply.v0",
  "title": "Model-authored grouping, summary and lint; positions are local input labels",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "facets", "view_groups", "summary", "lint_findings"],
  "properties": {
    "kind": {"enum": [null, "character", "clothing", "place", "object", "style", "other"]},
    "facets": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["facet_position", "groups"],
        "properties": {
          "facet_position": {"type": "integer", "minimum": 0},
          "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}}
        }
      }
    },
    "view_groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
    "summary": {"type": "string"},
    "lint_findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "message", "facet_positions", "observation_positions", "curated_positions"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string"},
          "facet_positions": {"$ref": "#/$defs/positions"},
          "observation_positions": {"$ref": "#/$defs/positions"},
          "curated_positions": {"$ref": "#/$defs/positions"}
        }
      }
    }
  },
  "$defs": {
    "positions": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "group": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "observation_positions"],
      "properties": {
        "value": {"type": "string"},
        "observation_positions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}
      }
    }
  }
}
