{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model_manifest.v0",
  "title": "Model manifest: the runtime record of model files under models/ (docs/model-storage.md)",
  "type": "object",
  "properties": {
    "schema": {"const": "model_manifest.v0"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "file": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9._ -]*(/[A-Za-z0-9_][A-Za-z0-9._ -]*)*$"},
          "size": {"anyOf": [{"type": "integer", "minimum": 0}, {"const": "pin_required"}]},
          "sha256": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"const": "pin_required"}]},
          "licence": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "gated": {"type": "boolean"}
        },
        "required": ["repository", "revision", "file", "size", "sha256", "licence", "path"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema", "entries"],
  "additionalProperties": false
}
