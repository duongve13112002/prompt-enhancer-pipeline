{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "image_observation.v0",
  "title": "Image observation",
  "$comment": "Stored document assembled by K2 from observer_reply.v0 and caller-owned identities/provenance. One context is one image-call bundle; the observations table repeats context_key and image-level fields per item.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_key",
    "image_id",
    "view",
    "quality",
    "origin",
    "observations"
  ],
  "properties": {
    "context_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "image_id": {
      "type": "string",
      "minLength": 1
    },
    "view": {
      "type": "string",
      "minLength": 1
    },
    "quality": {
      "type": "number"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "model_revision",
        "prompt_id",
        "facet_schema_version"
      ],
      "properties": {
        "origin": {
          "const": "generated"
        },
        "model_revision": {
          "type": "string",
          "minLength": 1
        },
        "prompt_id": {
          "type": "string",
          "minLength": 1
        },
        "facet_schema_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concept_id",
          "facet_group",
          "facet",
          "value",
          "visibility",
          "region"
        ],
        "properties": {
          "concept_id": {
            "type": "string",
            "minLength": 1
          },
          "facet_group": {
            "enum": [
              "identity",
              "apparel",
              "object",
              "place",
              "style",
              "incidental",
              "text_in_image"
            ]
          },
          "facet": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          },
          "visibility": {
            "enum": [
              "clear",
              "partial",
              "occluded",
              "not_shown"
            ]
          },
          "region": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  }
                },
                "description": "Region as fractions of the image size."
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
