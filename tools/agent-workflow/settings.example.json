{
  "_comment": "Template for the PM session hooks. Force pushes are refused by the structural guard (hooks/tool_guard.py, only `git push <push_remote> <push_branch>` passes), so there is no text glob for them (T-024 final round, F25). Copy to .claude/settings.local.json (git-ignored) and replace <PROJECT_ROOT> (absolute canonical checkout, forward slashes), <PERMISSION_ROOT> (the same path in permission-rule form, e.g. //d/Project_github/...) and <VENV_PYTHON> (absolute .venv interpreter). Details: tools/agent-workflow/README.md, section Guard hooks.",
  "permissions": {
    "deny": [
      "Read(**/.secrets/**)",
      "Read(<PERMISSION_ROOT>/.secrets/**)",
      "Grep(**/.secrets/**)",
      "Glob(**/.secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {"type": "command", "timeout": 30, "command": "<VENV_PYTHON>",
           "args": ["-B", "-I", "<PROJECT_ROOT>/tools/agent-workflow/hooks/process_guard.py"]}
        ]
      },
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {"type": "command", "timeout": 30, "command": "<VENV_PYTHON>",
           "args": ["-B", "-I", "<PROJECT_ROOT>/tools/agent-workflow/hooks/tool_guard.py", "--git-mode", "pm"]}
        ]
      },
      {
        "matcher": "ArtifactData",
        "hooks": [
          {"type": "command", "timeout": 30, "command": "<VENV_PYTHON>",
           "args": ["-B", "-I", "<PROJECT_ROOT>/tools/agent-workflow/hooks/question_guard.py"]}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {"type": "command", "timeout": 30, "command": "<VENV_PYTHON>",
           "args": ["-B", "-I", "<PROJECT_ROOT>/tools/agent-workflow/hooks/ctx_nudge.py",
                    "--role", "pm", "--thresholds", "300000,350000", "--loop-window", "4"]},
          {"type": "command", "timeout": 30, "command": "<VENV_PYTHON>",
           "args": ["-B", "-I", "<PROJECT_ROOT>/tools/agent-workflow/hooks/tool_monitor.py"]},
          {"type": "command", "timeout": 60, "command": "<VENV_PYTHON>",
           "args": ["-B", "-I", "<PROJECT_ROOT>/tools/agent-workflow/hooks/pm_invariants.py"]}
        ]
      },
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {"type": "command", "timeout": 30, "command": "<VENV_PYTHON>",
           "args": ["-B", "-I", "<PROJECT_ROOT>/tools/agent-workflow/hooks/git_ledger.py"]}
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {"type": "command", "timeout": 30, "command": "<VENV_PYTHON>",
           "args": ["-B", "-I", "<PROJECT_ROOT>/tools/agent-workflow/hooks/tool_monitor.py"]}
        ]
      },
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {"type": "command", "timeout": 30, "command": "<VENV_PYTHON>",
           "args": ["-B", "-I", "<PROJECT_ROOT>/tools/agent-workflow/hooks/git_ledger.py"]}
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {"type": "command", "timeout": 60, "command": "<VENV_PYTHON>",
           "args": ["-B", "-I", "<PROJECT_ROOT>/tools/agent-workflow/hooks/precompact_snapshot.py"]}
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {"type": "command", "timeout": 30, "command": "<VENV_PYTHON>",
           "args": ["-B", "-I", "<PROJECT_ROOT>/tools/agent-workflow/hooks/standing_rules.py"]},
          {"type": "command", "timeout": 30, "command": "<VENV_PYTHON>",
           "args": ["-B", "-I", "<PROJECT_ROOT>/tools/agent-workflow/hooks/session_context.py"]},
          {"type": "command", "timeout": 30, "command": "<VENV_PYTHON>",
           "args": ["-B", "-I", "<PROJECT_ROOT>/tools/agent-workflow/hooks/tool_health.py", "session-start"]}
        ]
      }
    ]
  }
}
